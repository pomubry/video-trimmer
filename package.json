{
  "name": "video-trimmer",
  "version": "1.0.0",
  "description": "A script to quickly trim a video using Node.js, FFmpeg, and mpv.",
  "main": "index.ts",
  "scripts": {
    "test": "npx tsc && vitest",
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=index.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pomubry/video-trimmer.git"
  },
  "author": "pomubry",
  "bugs": {
    "url": "https://github.com/pomubry/video-trimmer/issues"
  },
  "homepage": "https://github.com/pomubry/video-trimmer#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.7.2",
    "esbuild": "0.25.11",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.7",
    "memfs": "^4.51.1",
    "prettier": "3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8"
  }
}
